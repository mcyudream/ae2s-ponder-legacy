ae2s_ponder.gui.wireless_magnet.target.widget.pickup_mode=Matching modes
ae2s_ponder.gui.wireless_magnet.step.2=Check pickup mode, insertion mode and the master switch before enabling automatic collection.
ae2s_ponder.gui.wireless_magnet.target.widget.switch=Enable and test
ae2s_ponder.gui.wireless_magnet.step.3=Test with one drop and verify the destination, wireless connection, power and available network capacity.
ae2s_ponder.gui.priority.title=Storage priority
ae2s_ponder.gui.priority.target.widget.priority=Priority value
