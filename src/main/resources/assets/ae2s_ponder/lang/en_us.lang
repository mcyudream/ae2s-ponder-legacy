ae2s_ponder.gui.quartz_knife.target.slot.MACHINE_INPUT.0=Input
ae2s_ponder.gui.quartz_knife.step.1=Insert the material required by the installed naming recipe. Check the resulting item before confirming.
ae2s_ponder.gui.quartz_knife.target.slot.MACHINE_OUTPUT.0=Result
ae2s_ponder.gui.quartz_knife.step.2=Take the intended named output and verify the displayed name.
ae2s_ponder.gui.renamer.title=Rename a network device
ae2s_ponder.gui.renamer.target.widget.name=Descriptive name
